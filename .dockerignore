# .dockerignore — placed in the base folder alongside docker-compose.yml
# Excludes files from the build context sent to Docker.

# Runtime data (mounted as a volume — never baked into the image), including
# the data folder a local `node server.js` run creates
data/
src/data/

# Git history
.git/

# Node dependencies (installed fresh inside the image via npm install)
src/node_modules/

# Docker files themselves
Dockerfiles/
docker-compose.yml
.dockerignore

# Documentation
README.md
